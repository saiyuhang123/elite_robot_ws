<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inspire_gripper</name>
  <version>0.0.0</version>
  <description>Gripper control package for ROS 2.</description>
  <maintainer email="inspire001@todo.todo">inspire001</maintainer>
  <license>MIT</license> <!-- 或者您实际使用的许可证 -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>sensor_msgs</build_depend>
  <build_depend>message_filters</build_depend>
  <build_depend>serial</build_depend>
  <build_depend>service_interfaces</build_depend>
  
  <depend>example_interfaces</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>std_msgs</exec_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

